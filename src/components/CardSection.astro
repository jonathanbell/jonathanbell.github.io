---
interface Props {
  sectionTitle: string;
}

const { sectionTitle } = Astro.props;

let id = 0;

const sectionId = (): string => {
  if (sectionTitle === "") {
    return `section-${id++}`;
  }
  return sectionTitle.toLowerCase().replace(/\s/g, "-");
};
---

<section id={sectionId()} data-testid={`card-section--${sectionId()}`}>
  {sectionTitle !== "" ? (
    <h2 class="section-header">{sectionTitle}</h2>
  ) : (
    <h2 class="screenreader-only">Links</h2>
  )}
  <ul
    class={
      sectionTitle !== "" ? "card-container" : "card-container--without-heading"
    }
  >
    <slot />
  </ul>
</section>

<style>
  section {
    border-top: var(--section-rule);
    margin: 4rem 0 2rem 0;

    &:first-of-type {
      border-top: none;
    }

    @media (min-width: 768px) {
      margin-top: 6rem;

      &:first-of-type {
        border-top: var(--section-rule);
      }
    }
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }

    @media (min-width: 1024px) {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .card-container--without-heading {
    margin-top: 4rem;
  }
</style>

<style is:global>
  /* Highlight the section targeted by the URL hash. */
  section:target ul li.link-card {
    background-color: var(--colors-brand-base);
    box-shadow: 1px 1px 4px 1px #393939;
    transition: background-color 0.1s ease-in-out;

    &:hover {
      background-color: var(--colors-accent-deep-secondary);
    }

    a,
    a:hover {
      color: white !important;
    }
  }

  #projects .link-card {
    @media (min-width: 1024px) {
      aspect-ratio: 1;
    }
  }

  #writing .link-card h3 {
    @media (min-width: 768px) {
      min-height: 4rem;
    }
  }
</style>

---
import "@fontsource/ubuntu-sans/400.css";
import "@fontsource/ubuntu-sans/800.css";
---

<header>
  <h1>
    <a
      href={import.meta.env.SITE}
      data-testid="site-header__main-heading--link"
    >
      Jonathan Bell
    </a>
  </h1>
  <nav>
    <a href="/">Home</a>
    <a href="/#projects">Projects</a>
    <a href="/blog">Blog</a>
    <a href="/cv">Résumé</a>
  </nav>
</header>

<style>
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }

    100% {
      background-position: 100% 50%;
    }
  }

  header {
    display: grid;
  }

  h1 {
    font-family: "Ubuntu Sans", system-ui, sans-serif;
    font-weight: 800;
    font-size: 2.25rem;
    margin: 0;

    @media (min-width: 768px) {
      font-size: 3.375rem;
    }

    a {
      background: linear-gradient(345deg, var(--gradient-rainbow));
      background-size: 400%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;

      &:hover {
        animation: gradient 6s ease 1 forwards;
      }
    }
  }

  nav {
    order: -1;
    display: grid;
    justify-items: end;
    grid-template-columns: auto auto auto auto auto 1fr;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;

    a {
      font-weight: 500;
    }

    @media (min-width: 480px) {
      grid-template-columns: 1fr auto auto auto auto auto;
      gap: 0;

      a {
        margin-left: 0.5rem;
      }
    }
  }
</style>

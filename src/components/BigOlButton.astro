---
interface Props {
  link: string;
  text: string;
}

const { link, text } = Astro.props;
---

<a class="button--big-ol" href={link}>
  {text}
</a>

<style>
  a {
    font-family: system-ui, sans-serif;
    text-align: center;
    display: grid;
    align-items: center;
    font-weight: 600;
    background: var(--colors-fg-base);
    color: var(--colors-bg-base);
    min-height: 3.5rem;
    margin-bottom: 1rem;
    border: 2px solid var(--colors-fg-base);
    transition:
      border-color 0.1s var(--ease-snappy),
      background-color 0.1s var(--ease-snappy);
    max-width: 40rem;

    &:hover {
      background: var(--colors-hover-bg);
      color: var(--colors-fg-base);
    }
  }
</style>

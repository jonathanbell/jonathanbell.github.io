---
import BaseLayout from "./BaseLayout.astro";
import "@fontsource/ubuntu-sans/400.css";
import "@fontsource/ubuntu-sans/800.css";
const { frontmatter } = Astro.props;

const publishDate = new Date(frontmatter.publishDate);

const readableDate = publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const dateDateTime = publishDate.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${frontmatter.title} | Jonathan Bell`}
  description={frontmatter.description}
>
  <time datetime={dateDateTime}>{readableDate}</time>
  <slot />
</BaseLayout>

<style>
  time {
    color: var(--colors-base-midtone);
  }
</style>

<style is:global>
  /*
   * Global because the Markdown content arrives through a slot, and scoped
   * styles only reach elements rendered by this component.
   */
  article.content {
    h2 {
      font-size: 2.5rem;

      @media (min-width: 480px) {
        font-size: 3rem;
      }
    }

    & > h2 {
      margin-top: 4rem;
    }
  }
</style>

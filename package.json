{
  "name": "jonathanbell.github.io",
  "type": "module",
  "version": "2.12.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cv:pdf": "node scripts/generate-cv-pdf.ts",
    "prepare": "git config core.hooksPath .githooks",
    "playwright:install": "npx playwright install",
    "test": "astro build --silent && NODE_OPTIONS='--disable-warning=ExperimentalWarning' playwright test",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier --log-level silent . --write",
    "commit:lint": "commitlint --from=$(git rev-list --max-parents=0 HEAD) --to=HEAD",
    "changelog:create": "git fetch --tags --prune --prune-tags && node scripts/changelog.ts && git add CHANGELOG.md && echo 'CHANGELOG.md staged in Git'",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ubuntu-sans": "^5.2.10",
    "astro": "^7.2.4"
  },
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.42.1",
    "@types/node": "^26.2.0",
    "lint-staged": "^17.0.2",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,json,md,css}": "prettier --write"
  },
  "allowScripts": {
    "fsevents": false
  }
}
